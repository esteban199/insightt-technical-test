{
  "name": "tasklist-backend",
  "version": "1.0.0",
  "description": "Task List API — Express + TypeScript + MongoDB",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
